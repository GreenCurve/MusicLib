<Page
    x:Class="MusicLib.WinApp.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicLib.WinApp">

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- top: technical -->
        <TextBox x:Name="PathBox" Grid.Row="0" Header="Library home"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ImportButton" Content="Import..." Click="OnImportClick"/>
            <Button x:Name="ScanButton" Content="Scan" Click="OnScanClick"/>
            <TextBlock x:Name="DeviceLabel" VerticalAlignment="Center" FontSize="11" Opacity="0.7"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready"/>

        <!-- middle: track navigation (alphabetical by track name; click selects and plays) -->
        <ListView x:Name="TrackList" Grid.Row="3"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnTrackItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TrackItem">
                    <StackPanel Padding="4">
                        <TextBlock Text="{x:Bind Title}"/>
                        <TextBlock Text="{x:Bind Artist}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- bottom: playback -->
        <local:PlayerPanel x:Name="Player" Grid.Row="4"/>
    </Grid>
</Page>
