<Page
    x:Class="MusicLib.WinApp.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicLib.WinApp">

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="PathBox" Grid.Row="0" Header="Library home"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ImportButton" Content="Import..." Click="OnImportClick"/>
            <Button x:Name="ScanButton" Content="Scan" Click="OnScanClick"/>
            <TextBlock x:Name="DeviceLabel" VerticalAlignment="Center" FontSize="11" Opacity="0.7"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready"/>

        <ListView x:Name="TrackList" Grid.Row="3"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTrackItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TrackItem">
                    <Grid Padding="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{x:Bind Star}" FontSize="18"
                                Background="Transparent" BorderThickness="0" Padding="8,4"
                                Click="OnStarClick"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Display}"/>
                            <TextBlock Text="{x:Bind Sub}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
