<Page
    x:Class="MusicLib.WinApp.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="12">
        <TextBlock x:Name="TitleText" FontSize="20"/>
        <Slider x:Name="SeekSlider" Minimum="0" Maximum="1000"
                PointerPressed="OnSeekPressed" PointerCaptureLost="OnSeekReleased"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedText" Grid.Column="0" Text="0:00"/>
            <TextBlock x:Name="DurationText" Grid.Column="1" Text="0:00" HorizontalAlignment="Right"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PlayPauseButton" Content="Pause" Click="OnPlayPauseClick"/>
            <Button x:Name="StopButton" Content="Stop" Click="OnStopClick"/>
            <Button x:Name="FavButton" Click="OnFavClick"/>
        </StackPanel>
    </StackPanel>
</Page>
