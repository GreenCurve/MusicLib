<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<OutputType>WinExe</OutputType>
		<RootNamespace>MusicLib.WinApp</RootNamespace>
		<UseWinUI>true</UseWinUI>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Unpackaged: no MSIX, no store identity — simplest for personal use.
		     This means Program.cs has to bootstrap the app manually (see below). -->
		<WindowsPackageType>None</WindowsPackageType>
		<EnableMsixTooling>false</EnableMsixTooling>
		<SelfContained>false</SelfContained>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<Platforms>x64</Platforms>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\MusicLib.Core\MusicLib.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
		<!-- Same core LibVLCSharp approach as Android: no video surface, audio only. -->
		<PackageReference Include="LibVLCSharp" Version="3.9.7" />
		<PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
	</ItemGroup>
</Project>
