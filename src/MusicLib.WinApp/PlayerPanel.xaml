<UserControl
    x:Class="MusicLib.WinApp.PlayerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Layout follows the playback schema: cover on the left; on the right, name/artist with
         the volume control above, and play button + seekbar + time below. -->
    <Grid ColumnSpacing="12" Padding="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- No cover art is read from the files yet, so this is a placeholder. -->
        <Border Grid.Column="0" Width="88" Height="88" VerticalAlignment="Top"
                Background="#28808080">
            <TextBlock Text="&#x266A;" FontSize="32" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="ArtistText" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TitleText" FontSize="16" Text="Nothing selected" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <FontIcon Grid.Column="1" Glyph="&#xE767;" FontSize="16" VerticalAlignment="Center"/>
                <Slider x:Name="VolumeSlider" Grid.Column="2" Minimum="0" Maximum="100" Value="100"
                        VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPauseButton" Grid.Column="0" Content="&#x25B6;" Click="OnPlayPauseClick"/>
                <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1000" VerticalAlignment="Center"
                        PointerPressed="OnSeekPressed" PointerCaptureLost="OnSeekReleased"/>
                <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00 / 0:00" FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
